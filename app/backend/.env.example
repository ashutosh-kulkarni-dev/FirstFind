# ThriftFind backend config. Copy to .env and fill in secrets (never commit .env).

# ---- Environment ----
# "development" (default) or "production". In production the app HARD-FAILS at
# startup if FIRSTFIND_JWT_SECRET is weak.
ENVIRONMENT=development

# ---- Database ----
# Local dev = MySQL (DB_* below). Production = Supabase (Postgres): set a single
# DATABASE_URL and the DB_* parts are ignored. Supabase → Project Settings →
# Database → Connection string (URI). Add the SQLAlchemy driver prefix:
#   DATABASE_URL=postgresql+psycopg2://postgres:<password>@db.<ref>.supabase.co:5432/postgres
# DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=firstfind

# ---- Auth ----
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
FIRSTFIND_JWT_SECRET=dev-secret-change-in-prod

# Google sign-in (Phase 2). Leave blank to disable (endpoint returns 503).
# Google Cloud Console → APIs & Services → Credentials → Web client → Client ID.
# Authorized JS origins: https://your-app.vercel.app + http://localhost:5173
GOOGLE_CLIENT_ID=

# ---- CORS ----
# Production: your Vercel frontend origin(s), comma-separated. Replaces the
# localhost dev defaults.
# CORS_ORIGINS=https://your-app.vercel.app

# ---- Sentiment (HuggingFace Inference API) ----
# Required for the transformer sentiment; without it the app falls back to VADER.
HUGGINGFACE_TOKEN=
# Optional overrides:
# HF_SENTIMENT_MODEL=cardiffnlp/twitter-xlm-roberta-base-sentiment
# HF_API_URL=https://router.huggingface.co/hf-inference/models/cardiffnlp/twitter-xlm-roberta-base-sentiment
# HF_TIMEOUT=10

# ---- Chatbot LLM (Groq) ----
# Leave GROQ_API_KEY blank to use the offline rule-based chatbot.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
