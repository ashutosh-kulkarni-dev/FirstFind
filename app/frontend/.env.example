# Frontend build-time config (Vite embeds VITE_* at build time).
# Leave blank for local dev (requests stay relative and use the Vite proxy).
# In Vercel, set this to your deployed backend URL (no trailing slash):
#   VITE_API_BASE=https://thriftfind-api.onrender.com
VITE_API_BASE=

# Google sign-in (Phase 2). Leave blank to hide the Google button.
# Get from Google Cloud Console → OAuth 2.0 Web client → Client ID.
# Must also set GOOGLE_CLIENT_ID (same value) on the Render backend.
VITE_GOOGLE_CLIENT_ID=

# Map tile URL. Leave blank to use the free keyless CARTO dark basemap (dev default).
# Set to a keyed CARTO URL to switch style or use a production key.
# Example: https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png?key=YOUR_KEY
VITE_MAP_TILE_URL=
